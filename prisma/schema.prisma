// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@index([shop, isOnline])
}

model AppState {
  shop      String   @id
  stateJson String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model AiCreditAccount {
  id           String             @id @default(uuid())
  shop         String             @unique
  plan         String             @default("FREE") // "FREE" | "PRO"
  totalCredits Int                @default(15)
  usedCredits  Int                @default(0)
  bonusCredits Int                @default(0)
  cycleResetAt DateTime
  updatedAt    DateTime           @updatedAt
  createdAt    DateTime           @default(now())
  usageLogs    AiCreditUsageLog[]
}

model AiCreditUsageLog {
  id              String          @id @default(uuid())
  shop            String
  actionType      String          // "meta_fix" | "product_seo_fix" | "audit_change" | "vision_alt" | "copilot_brief"
  creditsDeducted Int
  productId       String?
  productTitle    String?
  modelUsed       String          @default("gemini-3.8-flash")
  tokensUsed      Int?
  createdAt       DateTime        @default(now())
  account         AiCreditAccount @relation(fields: [shop], references: [shop], onDelete: Cascade)

  @@index([shop, createdAt])
  @@index([createdAt])
}

model ProductRevision {
  id              String   @id @default(uuid())
  shop            String
  productId       String
  productTitle    String?
  changeType      String   // "METADATA_EDIT" | "HANDLE_EDIT" | "TITLE_EDIT" | "AI_APPLIED"
  beforeJson      String
  afterJson       String
  aiVerdictJson   String?
  scoreDelta      Int?
  redirectCreated Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([shop, productId])
  @@index([shop, createdAt])
}

model SeoAuditSnapshot {
  id             String   @id @default(uuid())
  shop           String
  overallScore   Int
  serpScore      Int
  contentScore   Int
  technicalScore Int
  visualScore    Int
  cannibalScore  Int
  criticalCount  Int
  warningCount   Int
  infoCount      Int
  summaryJson    String
  createdAt      DateTime @default(now())

  @@index([shop, createdAt])
}

model SuperAdminUser {
  id           String              @id @default(uuid())
  email        String              @unique
  name         String
  passwordHash String
  role         String              @default("ADMIN") // "OWNER" | "ADMIN"
  isActive     Boolean             @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  sessions     SuperAdminSession[]
}

model SuperAdminSession {
  id        String         @id @default(uuid())
  tokenHash String         @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime       @default(now())
  user      SuperAdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model StoreControl {
  shop                String   @id
  accessLevel         String   @default("FULL") // "FULL" | "PARTIAL" | "SUSPENDED"
  superAccess         Boolean  @default(false)
  allowedFeaturesJson String   @default("[]")
  notes               String?
  updatedBy           String?
  updatedAt           DateTime @updatedAt
  createdAt           DateTime @default(now())
}

model PlatformAiConfig {
  id          String   @id @default("default")
  provider    String   @default("gemini")
  model       String   @default("gemini-3.8-flash")
  apiKey      String   @default("")
  temperature Float    @default(0.4)
  isEnabled   Boolean  @default(true)
  updatedBy   String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}
